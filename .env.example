# ── Database ────────────────────────────────────────────────────────────────
# Leave unset for zero-setup local development (embedded PGlite in .data/).
# For Supabase/Postgres: Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Set to "false" to prevent auto-seeding demo data into an empty database
# (do this before connecting real accounts).
# DEMO_DATA=false

# ── Authentication (REQUIRED before deploying anywhere) ─────────────────────
# Passphrase that unlocks the dashboard. When unset, auth is disabled (local
# dev only).
# APP_PASSWORD=choose-a-long-passphrase
# Cookie sealing secret, 32+ chars:  openssl rand -base64 32
# SESSION_SECRET=

# ── Encryption ──────────────────────────────────────────────────────────────
# Encrypts Plaid access tokens at rest. 64 hex chars:  openssl rand -hex 32
# Required once you connect a real institution.
# APP_ENCRYPTION_KEY=

# ── Plaid (free sandbox: https://dashboard.plaid.com → Team Settings → Keys)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# Required for OAuth institutions (Chase, Capital One, …). Must EXACTLY match
# an entry under Dashboard → Developers → API → Allowed redirect URIs.
# Sandbox can use http on localhost; production must be https.
# PLAID_REDIRECT_URI=http://localhost:3000/plaid-oauth

# ── AI assistant (optional — dashboard works without it) ────────────────────
# ANTHROPIC_API_KEY=
